# Copy this file to .env and adjust if your setup differs from the defaults.

# Ollama running natively on this machine (not in Docker)
OLLAMA_HOST=http://localhost:11434

# Models pulled via `ollama pull` -- see scripts/setup_mac.sh
CODE_MODEL=qwen2.5-coder:32b
VISION_MODEL=llava

# Context window given to the code-writing model. 32768 is enough for a schema
# summary + a few sample rows + the question; it does NOT need to hold your
# whole document, since the model never sees the raw data (see README).
NUM_CTX=32768

# Where uploaded files and their DuckDB databases live
STORAGE_DIR=./storage/ingested
DUCKDB_DIR=./storage/duckdb
LOG_FILE=./logs/pipeline.log

# Sandbox limits
SANDBOX_TIMEOUT_SECONDS=30

# Delete ingested files older than this many hours (garbage collection script)
GC_MAX_AGE_HOURS=24

# Port the FastAPI service listens on
API_PORT=8080
