# Copy this file to .env and adjust if your setup differs from the defaults.
# Relative paths are resolved against the repo folder.

# Native Ollama on this machine (not Docker). 127.0.0.1 = this Mac only.
OLLAMA_HOST=http://127.0.0.1:11434

# Code model: writes the SQL/Python and phrases answers. Pinned in memory.
CODE_MODEL=qwen2.5-coder:32b
NUM_CTX=32768

# Vision model: ONLY for scanned PDF pages and images. Loaded during
# ingestion, evicted from memory as soon as ingestion finishes.
VISION_MODEL=qwen2.5vl:32b
VISION_NUM_CTX=16384
# How long the vision model stays loaded between pages of ONE document.
VISION_KEEP_ALIVE=10m

STORAGE_DIR=storage/ingested
DUCKDB_DIR=storage/duckdb
LOG_FILE=logs/pipeline.log

# Sandbox limits for model-generated code
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT_GB=8
# DuckDB's own limit inside the sandbox; it spills to disk past this.
# Keep it below SANDBOX_MEMORY_LIMIT_GB.
DUCKDB_MEMORY_LIMIT=6GB

# Delete ingested files older than this many hours
GC_MAX_AGE_HOURS=24
